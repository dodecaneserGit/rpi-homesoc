# Configuración del Nodo 1 (Raspberry Pi 4)
NODE1_IP=192.168.1.2
NODE2_IP=192.168.1.3
NODE3_IP=192.168.1.4

# Credenciales AdGuard Home
ADGUARD_USER=admin
ADGUARD_PASS=AdminSecurePassword2026!

# WireGuard (wg-easy)
DDNS_DOMAIN=mi-servidor.duckdns.org
# Generar hash bcrypt con: docker run --rm ghcr.io/wg-easy/wg-easy wgpw 'TuPassword'
WG_ADMIN_HASH=$2a$12$e8Y6e3fGZqW7Q...

# CrowdSec
CROWDSEC_AGENT_PASSWORD=SecretAgentPassRPi3!
CROWDSEC_ZERO_PASSWORD=SecretAgentPassZero!
CROWDSEC_HOMEPAGE_PASS=AdminSecurePassword2026!
