# Configuración del Nodo 1 (Raspberry Pi 4)
NODE1_IP=192.168.1.2
NODE2_IP=192.168.1.3
NODE3_IP=192.168.1.4

# Credenciales AdGuard Home
ADGUARD_USER=admin
ADGUARD_PASS=AdminSecurePassword2026!

# WireGuard (wg-easy)
# ATENCIÓN: DDNS_DOMAIN debe ser tu dominio público (ej: tu-subdominio.duckdns.org) o IP pública.
# NUNCA uses una IP local (192.168.1.x) si vas a conectarte desde datos móviles (4G/5G) o fuera de casa.
DDNS_DOMAIN=mi-servidor.duckdns.org
# Generar hash bcrypt con: docker run --rm ghcr.io/wg-easy/wg-easy wgpw 'TuPassword'
WG_ADMIN_HASH=$2a$12$e8Y6e3fGZqW7Q...
# MTU 1280 previene fragmentación y cuelgues en redes móviles 4G/5G y fibra PPPoE
WG_MTU=1280
# 0.0.0.0/0, ::/0 para túnel completo (Full Tunnel) con AdGuard, o 192.168.1.0/24, 10.8.0.0/24 para Split Tunnel
WG_ALLOWED_IPS=0.0.0.0/0, ::/0

# CrowdSec
CROWDSEC_AGENT_PASSWORD=SecretAgentPassRPi3!
CROWDSEC_ZERO_PASSWORD=SecretAgentPassZero!
CROWDSEC_HOMEPAGE_PASS=AdminSecurePassword2026!

# Alertas Telegram (RAM Guardian & Alertas del Clúster)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789
